#!/usr/bin/env python3
"""secret-fetch — inspect secrets without printing their values.

Usage:
  secret-fetch aws <secret-id> [--version-id V] [--version-stage S]
      [--profile P] [--region R]
      (--keys | --len | --hash | --shape KEY | --masked-json |
       --env-exec -- CMD…)        # default: --keys
  secret-fetch op <item> [--vault V] [--account A]

Never prints a raw secret value. On CLI failure, relays the CLI's stderr
(which contains error text, never values) and exits with its code.
"""
import hashlib
import json
import os
import re
import subprocess
import sys


def die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def run_cli(argv):
    try:
        r = subprocess.run(argv, capture_output=True, text=True)
    except FileNotFoundError:
        die(f"secret-fetch: {argv[0]} not found on PATH", 127)
    if r.returncode != 0:
        sys.stderr.write(r.stderr)
        sys.exit(r.returncode)
    return r.stdout


def mask_value(v):
    """Mask a single secret string. URLs keep structure, hide the password."""
    s = str(v)
    m = re.match(r"([a-zA-Z][a-zA-Z0-9+.-]*://[^:/@'\")]+:)([^@'\")]+)(@.*)", s)
    if m:
        return f"{m.group(1)}<redacted len={len(m.group(2))}>{m.group(3)}"
    if len(s) < 16:
        return f"<redacted len={len(s)}>"
    return f"{s[:3]}…{s[-2:]} (len={len(s)})"


def parse_kv(secret_string):
    """Return dict of key->value, or {'SecretString': raw} if not a JSON object."""
    try:
        d = json.loads(secret_string)
        if isinstance(d, dict):
            return d
    except (json.JSONDecodeError, TypeError):
        pass
    return {"SecretString": secret_string}


def take_flag(args, name):
    if name in args:
        i = args.index(name)
        if i + 1 >= len(args):
            die(f"secret-fetch: {name} requires a value")
        args.pop(i)
        return args.pop(i)
    return None


def aws_mode(args):
    if not args:
        die(__doc__)
    secret_id = args.pop(0)
    cli = ["aws", "secretsmanager", "get-secret-value", "--secret-id", secret_id]
    for flag, cli_flag in (
        ("--version-id", "--version-id"),
        ("--version-stage", "--version-stage"),
        ("--profile", "--profile"),
        ("--region", "--region"),
    ):
        v = take_flag(args, flag)
        if v:
            cli += [cli_flag, v]
    cli += ["--query", "SecretString", "--output", "text"]

    env_exec = None
    if "--env-exec" in args:
        i = args.index("--env-exec")
        rest = args[i + 1:]
        if rest and rest[0] == "--":
            rest = rest[1:]
        if not rest:
            die("secret-fetch: --env-exec requires `-- CMD…`")
        env_exec = rest
        args = args[:i]

    mode = "keys"
    shape_key = None
    for m in ("--keys", "--len", "--hash", "--masked-json"):
        if m in args:
            mode = m[2:]
            args.remove(m)
    if "--shape" in args:
        mode = "shape"
        shape_key = take_flag(args, "--shape")
    if args:
        die(f"secret-fetch: unexpected args: {' '.join(args)}")

    out = run_cli(cli)
    kv = parse_kv(out.rstrip("\n"))

    if env_exec is not None:
        env = dict(os.environ)
        if set(kv) == {"SecretString"}:
            env["SECRET_JSON"] = kv["SecretString"]
        else:
            for k, v in kv.items():
                env[k] = str(v)
        os.execvpe(env_exec[0], env_exec, env)
    if mode == "keys":
        for k in sorted(kv):
            print(k)
    elif mode == "len":
        for k in sorted(kv):
            print(f"{k}: len={len(str(kv[k]))}")
    elif mode == "hash":
        for k in sorted(kv):
            h = hashlib.sha256(str(kv[k]).encode()).hexdigest()[:12]
            print(f"{k}: sha256={h}")
    elif mode == "shape":
        if shape_key not in kv:
            die(f"secret-fetch: no key {shape_key!r}; keys: {', '.join(sorted(kv))}")
        print(f"{shape_key}: {mask_value(kv[shape_key])}")
    elif mode == "masked-json":
        print(json.dumps({k: mask_value(v) for k, v in kv.items()}, indent=2))


def op_mode(args):
    if not args:
        die(__doc__)
    item = args.pop(0)
    cli = ["op", "item", "get", item, "--format", "json"]
    vault = take_flag(args, "--vault")
    account = take_flag(args, "--account")
    if vault:
        cli += ["--vault", vault]
    if account:
        cli += ["--account", account]
    if args:
        die(f"secret-fetch: unexpected args: {' '.join(args)}")

    try:
        d = json.loads(run_cli(cli))
    except json.JSONDecodeError:
        die("secret-fetch: op returned non-JSON output")
    vault_name = (d.get("vault") or {}).get("name", "?")
    title = d.get("title", item)
    print(f"item: {title}  (vault: {vault_name})")
    print("label | type | purpose | masked value | op:// reference")
    for f in d.get("fields") or []:
        label = f.get("label") or f.get("id") or "?"
        ftype = f.get("type") or ""
        purpose = f.get("purpose") or ""
        val = f.get("value")
        if ftype == "CONCEALED":
            masked = f"<concealed len={len(val) if val else 0}>"
        elif not val:
            masked = "<empty>"
        else:
            s = str(val)
            masked = f"{s[:2]}…{s[-1:]} (len={len(s)})" if len(s) >= 12 else f"<redacted len={len(s)}>"
        ref = f"op://{vault_name}/{title}/{label}"
        print(f"{label} | {ftype} | {purpose} | {masked} | {ref}")


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0 if args else 1)
    mode = args.pop(0)
    if mode == "aws":
        aws_mode(args)
    elif mode == "op":
        op_mode(args)
    else:
        die(__doc__)


if __name__ == "__main__":
    main()
