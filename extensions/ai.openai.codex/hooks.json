{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|MultiEdit|Read|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/secret_guard.py",
            "timeout": 10,
            "statusMessage": "Checking for secrets"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|MultiEdit|Read|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/secret_guard.py",
            "timeout": 10,
            "statusMessage": "Scanning output for leaked secrets"
          }
        ]
      }
    ]
  }
}
